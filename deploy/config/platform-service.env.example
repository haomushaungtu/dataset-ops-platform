DF_PLATFORM_BIND_ADDRESS=10.100.165.139
DF_PLATFORM_PORT=19100
DF_PLATFORM_ADMIN_PORT=19101

DF_PLATFORM_DB_URL=jdbc:postgresql://postgres.example.internal:5432/dataset_platform
DF_PLATFORM_DB_USERNAME=replace-with-runtime-secret
DF_PLATFORM_DB_PASSWORD=replace-with-runtime-secret
DF_PLATFORM_DB_POOL_SIZE=15

# Development may use the private HTTP issuer. Production must use HTTPS.
DF_PLATFORM_OIDC_ISSUER=http://10.100.165.139:19000
DF_PLATFORM_OIDC_AUDIENCE=dataset-platform-api
DF_PLATFORM_IDENTITY_SYNC_ENABLED=true
DF_PLATFORM_IAM_BASE_URL=http://10.100.165.139:19000
DF_PLATFORM_IAM_CLIENT_ID=replace-with-platform-service-client-id
DF_PLATFORM_IAM_CLIENT_SECRET=replace-with-platform-service-client-secret

# Supplier qualification material storage. Keep disabled until every value is provisioned.
DF_PLATFORM_MINIO_ENABLED=false
DF_PLATFORM_MINIO_ENDPOINT=http://minio.example.internal:9000
DF_PLATFORM_MINIO_ACCESS_KEY=replace-with-runtime-secret
DF_PLATFORM_MINIO_SECRET_KEY=replace-with-runtime-secret
DF_PLATFORM_MINIO_BUCKET=replace-with-approved-bucket
DF_PLATFORM_MINIO_PREFIX=phase1/dev/supplier-qualification
