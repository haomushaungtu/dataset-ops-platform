# Dataverse 6.10.1 / Payara 7.2026.2 native Linux PoC profile.
# Credentials belong in 0600 runtime files and must never be committed.
JAVA_HOME=/home/hqd/jdk-21.0.12
DATAVERSE_HOME=/szah/dataset-foundry-poc/runtime/dataverse-6.10.1-installer/dvinstall
PAYARA_HOME=/szah/dataset-foundry-poc/runtime/payara7
DATAVERSE_FILES_DIR=/szah/dataset-foundry-poc/data/dataverse
DATAVERSE_LOG_DIR=/szah/dataset-foundry-poc/logs/dataverse
DATAVERSE_HTTP_HOST=127.0.0.1
DATAVERSE_HTTP_PORT=18080
DATAVERSE_HTTPS_PORT=18181
PAYARA_ADMIN_HOST=127.0.0.1
PAYARA_ADMIN_PORT=4848
PAYARA_HEAP_MB=1536
PAYARA_HAZELCAST_HOST=127.0.0.1
PAYARA_HAZELCAST_PORT=4900
HAZELCAST_SOCKET_BIND_ANY=false
HAZELCAST_SOCKET_SERVER_BIND_ANY=false
DATAVERSE_DB_HOST=replace-at-deploy-time
DATAVERSE_DB_PORT=5432
DATAVERSE_DB_NAME=dataverse_poc
DATAVERSE_DB_USER=dataverse_poc_app
DATAVERSE_DB_PASSWORD=replace-through-secure-runtime-file
DATAVERSE_SOLR_HOST=127.0.0.1
DATAVERSE_SOLR_PORT=18983
DATAVERSE_SOLR_CORE=collection1
# Apply the Hazelcast values as JVM options and verify every Payara listener with the OS socket table
# before enabling the service on a shared host. Keep host-level network policy as an independent layer.
