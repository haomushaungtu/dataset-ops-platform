# Dataverse 6.10.1 single-provider OIDC profile via MicroProfile Config.
# The auth-server URL is the issuer URL, not the discovery document URL.
# Validate discovery and JWKS first with deploy/scripts/oidc_readiness_check.py.
DATAVERSE_AUTH_OIDC_ENABLED=true
DATAVERSE_AUTH_OIDC_HIDDEN_JSF=false
DATAVERSE_AUTH_OIDC_CLIENT_ID=replace-with-dataverse-client-id
DATAVERSE_AUTH_OIDC_CLIENT_SECRET=replace-through-secure-runtime-source
DATAVERSE_AUTH_OIDC_AUTH_SERVER_URL=https://replace-with-reachable-idp/replace-with-issuer
DATAVERSE_AUTH_OIDC_PKCE_ENABLED=true
DATAVERSE_AUTH_OIDC_PKCE_METHOD=S256
DATAVERSE_AUTH_OIDC_TITLE=Enterprise SSO
DATAVERSE_AUTH_OIDC_SUBTITLE=Enterprise OpenID Connect

# Do not commit a real client secret or put it in a systemd unit. Supply it with
# an approved Payara/MicroProfile secret source and keep local fallback login
# until login, logout, role assignment, and disabled-user behavior are accepted.
