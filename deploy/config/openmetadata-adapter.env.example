DF_OM_ADAPTER_BIND_ADDRESS=127.0.0.1
DF_OM_ADAPTER_PORT=19110
DF_OM_ADAPTER_ADMIN_PORT=19111

# Internal HTTP is allowed only for the approved development network.
DF_OM_ADAPTER_OIDC_ISSUER=http://10.100.165.139:19000
DF_OM_ADAPTER_OIDC_AUDIENCE=dataset-platform-api
DF_OM_ADAPTER_IAM_TOKEN_URI=http://10.100.165.139:19000/oauth2/token
DF_OM_ADAPTER_IAM_CLIENT_ID=replace-with-openmetadata-adapter-client-id
DF_OM_ADAPTER_IAM_CLIENT_SECRET=replace-through-secure-runtime-file
DF_OM_ADAPTER_IAM_SCOPE=platform.internal

# The value must end in /api. 18585 is the isolated native PoC port; use the
# approved product port when the source-built service is promoted.
DF_OM_ADAPTER_BASE_URL=http://127.0.0.1:18585/api
DF_OM_ADAPTER_CONNECT_TIMEOUT=PT3S
DF_OM_ADAPTER_READ_TIMEOUT=PT10S
