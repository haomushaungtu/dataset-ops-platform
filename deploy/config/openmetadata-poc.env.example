# OpenMetadata 1.13.0 native Linux PoC profile.
# Supply database credentials through a 0600 runtime file; never commit them here.
# Before migration, run deploy/scripts/openmetadata-poc-gate.sh as documented in
# docs/planning/openmetadata-poc-runbook.md. pgcrypto must already be installed,
# and any unledgered partial 0.0.9 state must be repaired or restored by the DBA.
JAVA_HOME=/home/hqd/jdk-21.0.12
OPENMETADATA_HOME=/szah/dataset-foundry-poc/runtime/openmetadata-1.13.0
OPENMETADATA_CLUSTER_NAME=dataset-foundry-poc
SERVER_HOST=127.0.0.1
SERVER_PORT=18585
SERVER_ADMIN_PORT=18586
SERVER_HOST_API_URL=http://127.0.0.1:18585/api
OPENMETADATA_SERVER_URL=http://127.0.0.1:18585
DB_DRIVER_CLASS=org.postgresql.Driver
DB_SCHEME=postgresql
DB_HOST=replace-at-deploy-time
DB_PORT=5432
OM_DATABASE=openmetadata_poc
DB_USER=openmetadata_poc_app
DB_USER_PASSWORD=replace-through-secure-runtime-file
DB_PARAMS=sslmode=disable
DB_CONNECTION_POOL_MAX_SIZE=10
DB_CONNECTION_POOL_MIN_SIZE=2
DB_CONNECTION_POOL_MIN_IDLE=2
DB_CONNECTION_POOL_INITIAL_SIZE=2
SEARCH_TYPE=opensearch
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=19200
ELASTICSEARCH_SCHEME=http
PIPELINE_SERVICE_CLIENT_ENABLED=false
AUTHENTICATION_PROVIDER=basic
OPENMETADATA_HEAP_OPTS=-Xms768m -Xmx1536m -XX:+UseG1GC
