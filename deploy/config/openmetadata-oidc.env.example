# OpenMetadata 1.13.0 custom OIDC profile.
# Keep this file as a template only. Put client secrets in a 0600 runtime file
# after the IAM administrator supplies a reachable discovery endpoint and client registration.
# Validate discovery and JWKS first with deploy/scripts/oidc_readiness_check.py.
AUTHENTICATION_CLIENT_TYPE=confidential
AUTHENTICATION_PROVIDER=custom-oidc
AUTHENTICATION_RESPONSE_TYPE=code
CUSTOM_OIDC_AUTHENTICATION_PROVIDER_NAME=replace-with-idp-display-name

# The two client-id settings are consumed by different OpenMetadata authentication layers.
# Keep them identical unless the official deployment design explicitly separates them.
AUTHENTICATION_CLIENT_ID=replace-with-openmetadata-client-id
OIDC_CLIENT_ID=replace-with-openmetadata-client-id
OIDC_CLIENT_SECRET=replace-through-secure-runtime-file

AUTHENTICATION_AUTHORITY=http://replace-with-reachable-idp:19000
AUTHENTICATION_PUBLIC_KEYS=[http://replace-with-reachable-idp:19000/oauth2/jwks]
OIDC_DISCOVERY_URI=http://replace-with-reachable-idp:19000/.well-known/openid-configuration
OIDC_SCOPE=openid email profile groups
OIDC_TYPE=custom

# OpenMetadata 1.13.0 confidential OIDC uses the same root callback in both settings.
# Register this exact URI in IAM; /api/v1/callback is not the confidential-client callback.
AUTHENTICATION_CALLBACK_URL=http://replace-with-openmetadata-host:8585/callback
OIDC_CALLBACK=http://replace-with-openmetadata-host:8585/callback
OIDC_SERVER_URL=http://replace-with-openmetadata-host:8585

OIDC_RESPONSE_TYPE=code
OIDC_CLIENT_AUTH_METHOD=client_secret_post
OIDC_USE_NONCE=true
OIDC_PREFERRED_JWS=RS256
OIDC_DISABLE_PKCE=false
AUTHENTICATION_ENABLE_SELF_SIGNUP=false
AUTHENTICATION_ENABLE_AUTO_REDIRECT=false
# The current isolated development PoC is HTTP. Setting this to true prevents the
# browser from returning the session cookie. Production HTTPS must set it to true.
FORCE_SECURE_SESSION_COOKIE=false

# Use deterministic attributes emitted by backend/identity-service. Both mappings
# are required together by OpenMetadata 1.13.0 when explicit mapping is configured.
AUTHENTICATION_JWT_PRINCIPAL_CLAIMS=[preferred_username,email,sub]
AUTHENTICATION_JWT_PRINCIPAL_CLAIMS_MAPPING=[username:preferred_username,email:email]
AUTHENTICATION_JWT_TEAM_CLAIM_MAPPING=groups

# Enable provider-role import only after claim names and least-privilege mappings are accepted.
AUTHORIZER_USE_ROLES_FROM_PROVIDER=false
