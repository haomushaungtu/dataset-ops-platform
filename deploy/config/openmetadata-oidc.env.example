# OpenMetadata 1.13.0 custom OIDC profile.
# Keep this file as a template only. Put client secrets in a 0600 runtime file
# after the IAM administrator supplies a reachable discovery endpoint and client registration.
# Validate discovery and JWKS first with deploy/scripts/oidc_readiness_check.py.
AUTHENTICATION_CLIENT_TYPE=confidential
AUTHENTICATION_PROVIDER=customOidc
AUTHENTICATION_RESPONSE_TYPE=code
CUSTOM_OIDC_AUTHENTICATION_PROVIDER_NAME=replace-with-idp-display-name

# The two client-id settings are consumed by different OpenMetadata authentication layers.
# Keep them identical unless the official deployment design explicitly separates them.
AUTHENTICATION_CLIENT_ID=replace-with-openmetadata-client-id
OIDC_CLIENT_ID=replace-with-openmetadata-client-id
OIDC_CLIENT_SECRET=replace-through-secure-runtime-file

AUTHENTICATION_AUTHORITY=https://replace-with-reachable-idp/replace-with-issuer
AUTHENTICATION_PUBLIC_KEYS=[https://replace-with-reachable-idp/replace-with-jwks-path]
OIDC_DISCOVERY_URI=https://replace-with-reachable-idp/replace-with-issuer/.well-known/openid-configuration
OIDC_SCOPE=openid email profile
OIDC_TYPE=custom

# Replace these with the externally reachable OpenMetadata URL registered in IAM.
AUTHENTICATION_CALLBACK_URL=https://replace-with-openmetadata-host/api/v1/callback
OIDC_CALLBACK=https://replace-with-openmetadata-host/callback
OIDC_SERVER_URL=https://replace-with-openmetadata-host

OIDC_RESPONSE_TYPE=code
OIDC_CLIENT_AUTH_METHOD=client_secret_post
OIDC_USE_NONCE=true
OIDC_PREFERRED_JWS=RS256
OIDC_DISABLE_PKCE=false
AUTHENTICATION_ENABLE_SELF_SIGN_UP=false
AUTHENTICATION_ENABLE_AUTO_REDIRECT=false
FORCE_SECURE_SESSION_COOKIE=true

# Enable provider-role import only after claim names and least-privilege mappings are accepted.
AUTHORIZER_USE_ROLES_FROM_PROVIDER=false
