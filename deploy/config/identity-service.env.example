# Copy outside the repository, fill every required value, then chmod 0600.
# Never commit the populated file.
DF_IAM_BIND_ADDRESS=127.0.0.1
DF_IAM_PORT=19000
DF_IAM_ADMIN_PORT=19001
DF_IAM_COOKIE_SECURE=true
DF_IAM_ISSUER=https://identity.example.internal
DF_IAM_ALLOW_INSECURE_LOOPBACK=false
DF_IAM_ALLOW_INSECURE_PRIVATE_NETWORK=false
DF_IAM_RESOURCE_AUDIENCE=dataset-platform-api

# Isolated intranet development only: use an RFC1918 literal issuer, set this
# true, keep COOKIE_SECURE=false, and never copy those values to production.

DF_IAM_DB_URL=jdbc:postgresql://postgres.example.internal:5432/platform_identity?sslmode=require
DF_IAM_DB_USERNAME=platform_identity_app
DF_IAM_DB_PASSWORD=<replace-with-secret>
DF_IAM_DB_POOL_SIZE=10

DF_IAM_SIGNING_KEYSTORE=/szah/dataset-foundry/identity/secrets/signing.p12
DF_IAM_SIGNING_STORE_PASSWORD=<replace-with-secret>
DF_IAM_SIGNING_KEY_ALIAS=dataset-identity
DF_IAM_SIGNING_KEY_PASSWORD=<replace-with-secret>

# Used only when iam_user is empty. Remove these four variables after first successful boot.
DF_IAM_BOOTSTRAP_ADMIN_USERNAME=platform-admin
DF_IAM_BOOTSTRAP_ADMIN_PASSWORD=<replace-with-at-least-12-characters>
DF_IAM_BOOTSTRAP_ADMIN_EMAIL=platform-admin@example.internal
DF_IAM_BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Administrator

DF_IAM_OPENMETADATA_CLIENT_ID=openmetadata
DF_IAM_OPENMETADATA_CLIENT_SECRET=<replace-with-secret>
DF_IAM_OPENMETADATA_REDIRECT_URIS=https://metadata.example.internal/callback
DF_IAM_OPENMETADATA_POST_LOGOUT_REDIRECT_URIS=https://metadata.example.internal/

DF_IAM_DATAVERSE_CLIENT_ID=dataverse
DF_IAM_DATAVERSE_CLIENT_SECRET=<replace-with-secret>
DF_IAM_DATAVERSE_REDIRECT_URIS=https://data.example.internal/oauth2/callback
DF_IAM_DATAVERSE_POST_LOGOUT_REDIRECT_URIS=https://data.example.internal/

DF_IAM_PLATFORM_CLIENT_ID=dataset-platform-service
DF_IAM_PLATFORM_CLIENT_SECRET=<replace-with-secret>

DF_IAM_ACCESS_TOKEN_TTL=5m
DF_IAM_REFRESH_TOKEN_TTL=8h
